{
  "_说明": "陪伴体配置模板。复制为 config.json 后把 allowlist 改成你要聊的 QQ 号。",
  "_backend说明": "dsh = DSH 本机网关(127.0.0.1:8326)；workbuddy = WorkBuddy；ollama = 本地 Ollama（无需账号）",
  "backend": "dsh",
  "model": "deepseek-account/deepseek-flash",
  "_ollama说明": "backend 为 ollama 时，用 node tools/setup-ollama.js 自动填写这一段",
  "ollama": {
    "host": "http://127.0.0.1:11434",
    "model": "qwen2.5:7b",
    "temperature": 0.8,
    "maxTokens": 1024,
    "timeoutMs": 180000,
    "disableTools": true
  },
  "napcat": {
    "mode": "ws",
    "url": "ws://127.0.0.1:3002",
    "host": "127.0.0.1",
    "port": 3002,
    "accessToken": "companion-local-token"
  },
  "allowlist": [],
  "_allowlist说明": "填你的 QQ 号（数字，不带引号），例如 [123456789]。留空 = 不回复任何人。",
  "groups": [],
  "send": {
    "minGapMs": 550,
    "maxChars": 300,
    "burstWindowMs": 60000,
    "maxPerWindow": 25
  },
  "initiate": {
    "enabled": false,
    "_说明": "首次部署务必保持 false，观察几天再开。",
    "perDay": 6,
    "minIdleHours": 1.5,
    "maxIdleHours": 24,
    "activeHourFrom": 8,
    "activeHourTo": 23,
    "checkIntervalMs": 600000,
    "afterHerMessageMinutes": 20
  },
  "takeover": {
    "manualQuietMs": 1800000
  },
  "catchUp": {
    "enabled": true,
    "maxMessages": 20,
    "maxAgeHours": 48,
    "maxPerRun": 5
  }
}
